<UserControl x:Class="GestionStock.App.Views.DeliveriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <!-- Historique -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Bons de livraison" Style="{StaticResource Title}"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Rechercher (numéro ou client)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedDelivery}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="95"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*"/>
                    <DataGridTextColumn Header="Total (DA)" Binding="{Binding Total, StringFormat=N2}" Width="105"/>
                    <DataGridTextColumn Header="Reste (DA)" Binding="{Binding Remaining, StringFormat=N2}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="Détail du bon sélectionné" Style="{StaticResource Section}" Margin="0,16,0,6"/>
            <DataGrid Grid.Row="4" ItemsSource="{Binding SelectedDetails}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Montant / qté" Binding="{Binding Quantity, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Coef. / prix" Binding="{Binding UnitPrice, StringFormat=0.####}" Width="85"/>
                    <DataGridTextColumn Header="Facturé (DA)" Binding="{Binding LineTotal, StringFormat=N2}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Nouveau bon -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Nouveau bon de livraison" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Client * (tapez pour filtrer par nom ou ville)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"/>
                            <ComboBox ItemsSource="{Binding ClientChoices}" DisplayMemberPath="Name" SelectedItem="{Binding Client}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding DeliveryDate}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ClientChoicesHint}" Style="{StaticResource FieldLabel}" Margin="0,-4,0,6"/>
                    <TextBlock Text="{Binding ClientInfo}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Total du bon (DA)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Montant encaissé maintenant (DA)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2">
                        <Run Text="Reste à payer sur ce bon : "/><Run Text="{Binding Remaining, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4">
                        <Run Text="Nouvelle dette du client : "/><Run Text="{Binding NewDebt, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                    </TextBlock>
                    <TextBlock Text="Plafond de crédit dépassé : ce bon sera refusé." Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                               Visibility="{Binding OverLimit, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Enregistrer le bon" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Vider le formulaire" Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </StackPanel>

                <DockPanel Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Produits" Style="{StaticResource Section}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="+ Ajouter une ligne" Command="{Binding AddLineCommand}" Padding="10,4"/>
                        <Button Content="Retirer la ligne" Command="{Binding RemoveLineCommand}" Padding="10,4"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                               Text="Crédit virtuel : montant à envoyer et coefficient de vente (ex. 5 000 × 0,98 = 4 900 DA facturés). Le dernier coefficient de ce client est proposé automatiquement."/>
                    <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Produit" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2" ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedItem="{Binding Product, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockText, Mode=OneWay}" Width="95" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Montant/qté" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Coef. / prix" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2" Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Facturé (DA)" Binding="{Binding Total, StringFormat=N2, Mode=OneWay}" Width="95" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
