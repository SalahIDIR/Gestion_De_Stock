<UserControl x:Class="GestionStock.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Liste des clients" Style="{StaticResource Title}"/>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Rechercher (nom, ville, adresse)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Run Text="Dettes affichées : "/><Run Text="{Binding TotalDisplayedDebt, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                    </TextBlock>
                    <CheckBox Content="Seulement les clients non soldés (débiteurs)" IsChecked="{Binding OnlyDebtors}" Margin="0"/>
                </DockPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Ville" Binding="{Binding City}" Width="120"/>
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="110"/>
                    <DataGridTextColumn Header="Plafond (DA)" Binding="{Binding CreditLimit, StringFormat=N0}" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Dette (DA)" Binding="{Binding Debt, StringFormat=N2}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Section}" Margin="0,0,0,12"/>

                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Ville" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Plafond de dette en DA (vide = aucun plafond)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Puces de réception du crédit" Style="{StaticResource Section}"/>
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding OperatorName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Nouveau" Command="{Binding NewCommand}"/>
                        <Button Content="Supprimer" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Separator Margin="0,20,0,4"/>
                        <TextBlock Text="Encaissement" Style="{StaticResource Section}"/>
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="Dette actuelle : "/><Run Text="{Binding SelectedDebt, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                        </TextBlock>
                        <TextBlock Text="Montant encaissé (DA)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Note (facultatif)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PaymentNote, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Encaisser" Command="{Binding AddPaymentCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
