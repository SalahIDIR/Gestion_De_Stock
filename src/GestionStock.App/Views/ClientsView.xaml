<UserControl x:Class="GestionStock.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionStock.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="RiskDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{Binding Risk, Converter={StaticResource RiskToBrush}}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Text="Liste des clients" Style="{StaticResource Title}"/>
                <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            </DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Rechercher (nom, ville, adresse)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Seulement les clients non soldés (débiteurs)" IsChecked="{Binding OnlyDebtors}" Margin="0" VerticalAlignment="Bottom" Height="26"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dette min. (DA)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DebtMin, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Dette max. (DA)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DebtMax, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Run Text="Dettes affichées : "/><Run Text="{Binding TotalDisplayedDebt, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                    </TextBlock>
                    <TextBlock Text="● orange = pas encaissé depuis 7 jours   ● rouge = 10 jours ou plus" Style="{StaticResource FieldLabel}"/>
                </DockPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Style="{StaticResource RiskDot}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Ville" Binding="{Binding City}" Width="110"/>
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="105"/>
                    <DataGridTextColumn Header="Plafond (DA)" Binding="{Binding CreditLimit, StringFormat=N0}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Dette (DA)" Binding="{Binding Debt, StringFormat=N2}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                                <Setter Property="Foreground" Value="{Binding Risk, Converter={StaticResource RiskToBrush}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Retard" Width="70" IsReadOnly="True">
                        <DataGridTextColumn.Binding>
                            <Binding Path="DaysSincePayment" StringFormat="{}{0} j"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding Risk, Converter={StaticResource RiskToRowBackground}}"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Section}" Margin="0,0,0,12"/>

                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Ville" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Plafond de dette en DA (vide = aucun plafond)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Puces de réception du crédit" Style="{StaticResource Section}"/>
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChipEditor}">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding OperatorName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Number1, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Visibility="{Binding ShowSecond, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="8,4" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveSecondNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Retirer le 2ᵉ numéro"/>
                                            <TextBox DockPanel.Dock="Left" Text="{Binding Number2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <Button Content="+ Ajouter un 2ᵉ numéro" HorizontalAlignment="Left" Padding="6,2" Margin="0,-4,0,4"
                                            Visibility="{Binding ShowAddButton, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.AddSecondNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Nouveau" Command="{Binding NewCommand}"/>
                        <Button Content="Supprimer" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Separator Margin="0,20,0,4"/>
                        <TextBlock Text="Dette" Style="{StaticResource Section}"/>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="Dette actuelle : "/><Run Text="{Binding SelectedDebt, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                            <LineBreak/>
                            <Run Text="Pour encaisser un paiement, créez un « bon d'encaissement » depuis la page Bons de livraison." FontSize="11" Foreground="Gray"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
