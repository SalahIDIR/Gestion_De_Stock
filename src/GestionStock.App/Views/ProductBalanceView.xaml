<UserControl x:Class="GestionStock.App.Views.ProductBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Bilan produits" Style="{StaticResource Title}"/>
            <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource FieldLabel}"
                           Text="Quantité : stock actuel de chaque produit, quelle que soit la période. Achats, ventes et marge : activité sur la période choisie. La marge est une estimation (ventes moins quantité vendue × dernier prix d'achat connu du produit)."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Margin="0,0,32,4"><Run Text="Total achats : " Foreground="Gray"/><Run Text="{Binding TotalAchats, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                    <TextBlock Margin="0,0,32,4"><Run Text="Total ventes : " Foreground="Gray"/><Run Text="{Binding TotalVentes, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Total marge : " Foreground="Gray"/><Run Text="{Binding TotalMarge, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Margin="0,0,32,0"><Run Text="Total versements : " Foreground="Gray"/><Run Text="{Binding TotalVersements, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                    <TextBlock Margin="0,0,32,0"><Run Text="Total dépenses : " Foreground="Gray"/><Run Text="{Binding TotalDepenses, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                    <TextBlock><Run Text="Total : " Foreground="Gray"/><Run Text="{Binding TotalNet, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="22">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Quantité" Binding="{Binding QuantityText}" Width="120"
                                    ToolTipService.ToolTip="Stock actuel, indépendant de la période choisie">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Achats (DA)" Binding="{Binding AchatsText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ventes (DA)" Binding="{Binding VentesText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Marge (DA)" Binding="{Binding MargeText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
