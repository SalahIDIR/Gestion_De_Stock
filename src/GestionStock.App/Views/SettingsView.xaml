<UserControl x:Class="GestionStock.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GestionStock.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource Title}"/>

            <!-- Général -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Général" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <TextBlock Text="E-mail de l'entreprise" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Début de l'inventaire comptable" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding InventoryStart}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fin de l'inventaire comptable" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding InventoryEnd}"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Enregistrer" Command="{Binding SaveGeneralCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Routage matériel -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Routage matériel (ports COM) et requêtes USSD" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PortsHint}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Assignez un port COM à chaque opérateur. La requête USSD est un modèle avec les variables {numero} et {montant}. Le transfert se fait en deux échanges : le code envoyé déclenche une invite de confirmation, puis le chiffre de confirmation déclenche le message final ; le succès est détecté par le mot-clé, dans ce message ou dans un SMS séparé si l'opérateur confirme par SMS. Ces codes viennent de l'opérateur et peuvent changer : corrigez-les ici si besoin."/>
                    <ItemsControl ItemsSource="{Binding Routing}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,8,0"
                                                      ItemsSource="{Binding DataContext.AvailablePorts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding UssdTemplate, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Requête USSD, ex. *760*{numero}*{montant}*2008#"/>
                                            <Button Grid.Column="3" Content="Enregistrer" Margin="0"
                                                    Command="{Binding DataContext.SaveRoutingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Grid Margin="90,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Confirmation" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding ConfirmKeystroke, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                         ToolTip="Chiffre renvoyé quand le réseau demande confirmation, ex. 1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Mot-clé de succès" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding SuccessKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                         ToolTip="Mot recherché dans le message final (ou le SMS) qui indique un transfert réussi"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="Confirmation par SMS" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                      IsChecked="{Binding ConfirmationViaSms}"
                                                      ToolTip="Cochez si le message final de confirmation arrive par SMS séparé plutôt que dans la session USSD (cas de Mobilis)"/>
                                        </Grid>
                                        <StackPanel Margin="90,6,0,0" Width="230" HorizontalAlignment="Left">
                                            <TextBlock Text="Code de consultation du solde" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding BalanceUssdCode, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                                     ToolTip="Code USSD sans confirmation qui renvoie le solde disponible sur la puce, ex. *766#"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Tester connexion" Command="{Binding TestConnectionCommand}"
                                ToolTip="Envoie le code de consultation du solde aux 3 puces pour vérifier la connexion"/>
                        <TextBlock Text="Test en cours…" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mot de passe -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                <StackPanel MaxWidth="320" HorizontalAlignment="Left">
                    <TextBlock Text="Mot de passe administrateur" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <TextBlock Text="Mot de passe actuel" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Nouveau mot de passe" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Confirmer le nouveau mot de passe" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Modifier le mot de passe" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Démonstration -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Données de démonstration" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Ajoute 300 clients, 5 fournisseurs et environ 3 mois d'opérations fictives (bons d'achat, bons de livraison, encaissements) pour essayer l'application. À utiliser sur une base de test uniquement."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Générer les données de démo" Command="{Binding GenerateDemoDataCommand}"/>
                        <TextBlock Text="Génération en cours…" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   Visibility="{Binding IsGeneratingDemo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
