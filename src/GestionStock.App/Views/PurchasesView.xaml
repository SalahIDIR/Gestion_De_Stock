<UserControl x:Class="GestionStock.App.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Historique -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,12"/>
                <TextBlock Text="Bons d'achat" Style="{StaticResource Title}"/>
            </DockPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Rechercher (numéro ou fournisseur)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding HistoryFrom}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding HistoryTo}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Montant min." Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding HistoryAmountMin, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Montant max." Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding HistoryAmountMax, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="3" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedPurchase}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="100"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Fournisseur" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="Total (DA)" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Reste dû (DA)" Binding="{Binding Remaining, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="4">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Nouveau bon d'achat" Command="{Binding OpenFormCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Modifier le bon" Command="{Binding EditCommand}"/>
                    <Button Content="Supprimer le bon" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
                <TextBlock Text="Détail du bon sélectionné" Style="{StaticResource Section}" Margin="0,12,0,6"/>
            </StackPanel>
            <DataGrid Grid.Row="5" ItemsSource="{Binding SelectedDetails}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Quantité / montant" Binding="{Binding Quantity, StringFormat=N2}" Width="140"/>
                    <DataGridTextColumn Header="Coef. / prix" Binding="{Binding UnitCost, StringFormat=0.####}" Width="90"/>
                    <DataGridTextColumn Header="Coût (DA)" Binding="{Binding LineTotal, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPayment}" Value="True">
                                <Setter Property="Background" Value="#1A16A34A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>

        <!-- Nouveau bon : fenêtre par-dessus la liste, ouverte par le bouton « + Nouveau bon d'achat » -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
        <Border Background="#66101828" Margin="-24"/>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"
                Width="680" HorizontalAlignment="Center" Margin="0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕ Fermer" Command="{Binding CloseFormCommand}" Margin="0" Padding="10,4"
                                ToolTip="Fermer sans enregistrer (la saisie est conservée)"/>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Title}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Text="Fournisseur *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="CompanyName" SelectedItem="{Binding Supplier}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Total du bon (DA)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Montant payé (DA)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,12">
                        <Run Text="Reste dû au fournisseur : "/><Run Text="{Binding Remaining, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
                        <Button Content="Enregistrer et imprimer" Command="{Binding SaveAndPrintCommand}" Margin="0,0,8,6"/>
                        <Button Content="Imprimer le bon" Command="{Binding PrintEditingCommand}" Margin="0,0,8,6"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                ToolTip="Imprime le bon tel qu'il est enregistré, sans les modifications en cours"/>
                        <Button Content="Vider le formulaire" Command="{Binding ResetCommand}" Margin="0,0,8,6"/>
                    </WrapPanel>
                </StackPanel>

                <DockPanel Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Produits" Style="{StaticResource Section}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="+ Ajouter une ligne" Command="{Binding AddLineCommand}" Padding="10,4"/>
                        <Button Content="Retirer la ligne" Command="{Binding RemoveLineCommand}" Padding="10,4"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                               Text="Crédit virtuel : saisissez le montant reçu et le coefficient (ex. 1 000 000 × 0,9725 = 972 500 DA payés). Produit physique : quantité et prix unitaire."/>
                    <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Produit" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2" ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedItem="{Binding Product, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Montant / qté" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Coef. / prix" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Coût (DA)" Binding="{Binding Total, StringFormat=N2, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
