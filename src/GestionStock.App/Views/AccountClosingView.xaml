<UserControl x:Class="GestionStock.App.Views.AccountClosingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Solde des comptes" Style="{StaticResource Title}"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date du dernier solde" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding PreviousDateText}" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Text="Montant du dernier solde" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding PreviousTotal, StringFormat=N2}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Now, StringFormat=dd/MM/yyyy HH:mm:ss}" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <Button Content="Actualiser" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                            ToolTip="Recalcule les statistiques et les recettes/dépenses jusqu'à maintenant"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Imprimer" Command="{Binding PrintCommand}"/>
            <Button Content="Valider ce solde" Command="{Binding ValidateCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Différer" Command="{Binding DifferCommand}"
                    ToolTip="Remet le prélèvement et le commentaire à zéro sans rien enregistrer"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Statistiques + Résultats -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Statistiques" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stock en valeur" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StockValue, StringFormat=N2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Crédit clients" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ClientCredit, StringFormat=N2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Crédit fournisseurs" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SupplierCredit, StringFormat=N2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Espèce" VerticalAlignment="Center" ToolTip="Calculée automatiquement : ancien espèce + recettes − dépenses"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cash, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prélèvements" VerticalAlignment="Center" ToolTip="Charges prélevées en espèce à saisir vous-même (ex. nourriture)"/>
                        <TextBox Grid.Column="1" Text="{Binding PrelevementsText, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalContentAlignment="Right"/>
                    </Grid>

                    <Separator Margin="0,6,0,14"/>

                    <TextBlock Text="Résultats" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nouveau solde (Total)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=N2}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bénéfice" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Benefice, StringFormat=N2}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Moyenne / jour" VerticalAlignment="Center" FontWeight="SemiBold"
                                   ToolTip="Bénéfice ÷ nombre de jours écoulés depuis la dernière clôture"/>
                        <TextBlock Grid.Column="1" Text="{Binding Moyenne, StringFormat=N2}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recettes en entrées sorties + commentaires -->
            <StackPanel Grid.Column="2">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Recettes en entrées sorties" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                        <TextBlock Text="Depuis la dernière clôture jusqu'à maintenant." Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ancien espèce" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PreviousCash, StringFormat=N2}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total des recettes" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalRecettes, StringFormat=N2}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total des dépenses" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalDepenses, StringFormat=N2}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total" VerticalAlignment="Center" FontWeight="SemiBold"
                                       ToolTip="Ancien espèce + recettes − dépenses = Espèce"/>
                            <TextBlock Grid.Column="1" Text="{Binding Cash, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Commentaires" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
