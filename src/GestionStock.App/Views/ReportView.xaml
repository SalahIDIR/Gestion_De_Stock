<UserControl x:Class="GestionStock.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Rapport des opérations" Style="{StaticResource Title}"/>
            <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Achats" IsChecked="{Binding ShowAchats}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Content="Ventes" IsChecked="{Binding ShowVentes}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="2" Content="Encaissements" IsChecked="{Binding ShowEncaissements}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding ProductFilters}" DisplayMemberPath="Label" SelectedItem="{Binding ProductFilter}" Margin="0" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tiers (client ou fournisseur)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TiersSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Montant min." Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AmountMin, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Montant max." Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AmountMax, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,32,0"><Run Text="Total achats : " Foreground="Gray"/><Run Text="{Binding TotalAchats, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                <TextBlock Margin="0,0,32,0"><Run Text="Total ventes : " Foreground="Gray"/><Run Text="{Binding TotalVentes, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
                <TextBlock><Run Text="Total encaissements : " Foreground="Gray"/><Run Text="{Binding TotalEncaissements, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/></TextBlock>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="22">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       Visibility="{Binding HasProduct, Converter={StaticResource BoolToVis}}"
                                       Fill="{Binding ProductColorHex, Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="95"/>
                <DataGridTextColumn Header="Tiers" Binding="{Binding Tiers}" Width="*"/>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="110"/>
                <DataGridTextColumn Header="Qté / montant" Binding="{Binding QuantityText}" Width="105"/>
                <DataGridTextColumn Header="Coef. / prix" Binding="{Binding RateText}" Width="90"/>
                <DataGridTextColumn Header="Total (DA)" Binding="{Binding Total, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
