<Window x:Class="GestionStock.App.Views.ConnectionCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Stock" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32,28">
        <TextBlock Text="Connexion des opérateurs" Style="{StaticResource Title}" Foreground="{StaticResource Accent}"/>

        <TextBlock Text="Test de connexion des modems en cours…" Foreground="{StaticResource Muted}" Margin="0,0,0,12"
                   Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}"/>

        <ItemsControl ItemsSource="{Binding Operators}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Margin="0,4,12,0" VerticalAlignment="Top"
                                     Fill="{Binding State, Converter={StaticResource LinkStateToBrush}}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Tous les opérateurs sont en ligne." Foreground="#027A48" FontWeight="SemiBold" Margin="0,0,0,12"
                   Visibility="{Binding AllOnline, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Style="{StaticResource ErrorText}" Margin="0,0,0,12"
                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"
                   Text="Certains opérateurs ne sont pas joignables. Vous pouvez continuer, mais les transferts de crédit vers ces opérateurs échoueront tant que leur modem n'est pas en ligne."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Retester" Command="{Binding RefreshCommand}"/>
            <Button Content="Continuer" Click="Continue_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
