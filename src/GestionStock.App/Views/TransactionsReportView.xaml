<UserControl x:Class="GestionStock.App.Views.TransactionsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Rapport des transactions (crédit virtuel)" Style="{StaticResource Title}"/>
            <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Achats et ventes de crédit virtuel (Flexy, Storm, Erselli…). Les encaissements et les produits physiques n'apparaissent pas ici : ils sont dans l'Historique."
                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Achats" IsChecked="{Binding ShowAchats}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Content="Ventes" IsChecked="{Binding ShowVentes}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ProductFilters}" DisplayMemberPath="Label" SelectedItem="{Binding ProductFilter}" Margin="0" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tiers (client ou fournisseur)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TiersSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
            <WrapPanel>
                <TextBlock Margin="0,0,32,4"><Run Text="Crédit acheté : " Foreground="Gray"/><Run Text="{Binding CreditAchete, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA  (coût "/><Run Text="{Binding CoutAchats, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA)"/></TextBlock>
                <TextBlock Margin="0,0,0,4"><Run Text="Crédit vendu : " Foreground="Gray"/><Run Text="{Binding CreditVendu, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA  (facturé "/><Run Text="{Binding TotalVentes, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA)"/></TextBlock>
            </WrapPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="22">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       Fill="{Binding ProductColorHex, Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="115"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="95"/>
                <DataGridTextColumn Header="Tiers" Binding="{Binding Tiers}" Width="*"/>                
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="90"/>
                <DataGridTextColumn Header="Puce destinataire" Binding="{Binding RecipientPhoneText}" Width="130"
                                    ToolTipService.ToolTip="Numéro de la puce à laquelle le crédit a été envoyé"/>
                <DataGridTextColumn Header="Montant crédit (DA)" Binding="{Binding QuantityText}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Crédit restant (DA)" Binding="{Binding StockAfterText}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="ToolTip" Value="Stock du produit juste après cette transaction"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowColorHex, Converter={StaticResource HexToRowBackground}}"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</UserControl>
