<UserControl x:Class="GestionStock.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="Produits &amp; stock" Style="{StaticResource Title}"/>
                <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Rechercher (nom)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding KindFilters}" DisplayMemberPath="Label" SelectedItem="{Binding KindFilter}" Margin="0"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="26">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="130"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockBalance, StringFormat=N2}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Prix d'achat" Binding="{Binding PurchaseCostText}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                                <Setter Property="ToolTip" Value="Coefficient (crédit virtuel) ou prix unitaire (produit physique) du dernier bon d'achat"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total (DA)" Binding="{Binding StockValue, StringFormat=N2, TargetNullValue=—}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="ToolTip" Value="Stock × prix d'achat"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Actif" Binding="{Binding ActiveLabel}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3">
                <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Run Text="Valeur totale du stock (au dernier prix d'achat) : " Foreground="Gray"/><Run Text="{Binding TotalStockValue, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" DA"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="+ Nouveau produit" Command="{Binding OpenFormCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Modifier le produit" Command="{Binding EditCommand}"/>
                    <Button Content="Corriger le stock" Command="{Binding OpenAdjustCommand}"/>
                    <Button Content="Supprimer le produit" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
                <TextBlock Text="Mouvements du produit sélectionné" Style="{StaticResource Section}" Margin="0,12,0,6"/>
            </StackPanel>
            <DataGrid Grid.Row="4" ItemsSource="{Binding Movements}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="100"/>
                    <DataGridTextColumn Header="Quantité" Binding="{Binding QuantityText}" Width="130"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Fiche produit : fenêtre par-dessus la liste, ouverte par « + Nouveau produit » ou « Modifier le produit » -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66101828" Margin="-24"/>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕ Fermer" Command="{Binding CloseFormCommand}" Margin="0" Padding="10,4"
                                ToolTip="Fermer sans enregistrer (la saisie est conservée)"/>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Title}" Margin="0"/>
                    </DockPanel>

                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                              SelectedValue="{Binding Kind}"/>
                    <CheckBox Content="Produit actif" IsChecked="{Binding IsActive}"/>

                    <TextBlock Text="Couleur dans le rapport" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,2,0,6">
                        <Rectangle DockPanel.Dock="Left" Width="26" Height="26" RadiusX="4" RadiusY="4" Margin="0,0,8,0"
                                   Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Stroke="{StaticResource Line}"/>
                        <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="22" Height="22" Margin="0,0,6,6" Padding="0" BorderThickness="1" BorderBrush="{StaticResource Line}"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Annuler" Command="{Binding CloseFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Correction d'inventaire du produit sélectionné -->
        <Grid Visibility="{Binding IsAdjustOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66101828" Margin="-24"/>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="✕ Fermer" Command="{Binding CloseAdjustCommand}" Margin="0" Padding="10,4"/>
                        <TextBlock Text="{Binding AdjustTitle}" Style="{StaticResource Section}" Margin="0" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding AdjustCurrent}" Margin="0,0,0,10"/>
                    <TextBlock Text="Solde réellement compté" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CountedBalance, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Motif (facultatif)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding AdjustNote, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Corriger le stock" Command="{Binding AdjustCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Annuler" Command="{Binding CloseAdjustCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
