<UserControl x:Class="GestionStock.App.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Text="Liste des fournisseurs" Style="{StaticResource Title}"/>
                <Button DockPanel.Dock="Right" Content="Imprimer" Command="{Binding PrintCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            </DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Rechercher (référence, raison sociale)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dette min. (DA)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DebtMin, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dette max. (DA)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DebtMax, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="+ Nouveau fournisseur" Command="{Binding OpenFormCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Modifier le fournisseur" Command="{Binding EditCommand}"/>
                <Button Content="Supprimer le fournisseur" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="110"/>
                    <DataGridTextColumn Header="Raison sociale" Binding="{Binding CompanyName}" Width="*"/>
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="Dette (DA)" Binding="{Binding Debt, StringFormat=N2}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Fiche fournisseur : fenêtre par-dessus la liste, ouverte par « + Nouveau fournisseur » ou « Modifier le fournisseur » -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66101828" Margin="-24"/>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18"
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕ Fermer" Command="{Binding CloseFormCommand}" Margin="0" Padding="10,4"
                                ToolTip="Fermer sans enregistrer (la saisie est conservée)"/>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Title}" Margin="0"/>
                    </DockPanel>

                    <TextBlock Text="Référence *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Raison sociale *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Téléphone 1" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone1, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Téléphone 2" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Solde initial en DA (dette reprise d'avant le logiciel ; négatif = avoir)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Annuler" Command="{Binding CloseFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
