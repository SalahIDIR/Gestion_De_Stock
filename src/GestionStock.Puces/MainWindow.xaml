<Window x:Class="GestionStock.Puces.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messages des puces" Width="960" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F4F6F8">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Port du modem" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="110" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
                    <Button Content="Actualiser" Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0"/>
                    <Button Content="Tester le modem" Command="{Binding TestConnectionCommand}" Margin="24,0,0,0"/>
                    <Button Content="Lire les SMS de la SIM" Command="{Binding ReadMessagesCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Code de solde (USSD)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="160" Text="{Binding BalanceCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Consulter le solde" Command="{Binding CheckBalanceCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding BalanceResult}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#667085" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
            <ListBox ItemsSource="{Binding Messages}" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Phone}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=date inconnue}" FontSize="11" Foreground="#667085" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding DirectionLabel}" FontSize="11" Foreground="#1F4E79" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Body}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
