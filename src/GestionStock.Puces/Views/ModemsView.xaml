<UserControl x:Class="GestionStock.Puces.Views.ModemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#667085" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Opérateurs, avec pastille verte si le modem a répondu au test -->
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Changer les ports" Command="{Binding ChangePortsCommand}" Margin="8"/>
                    <ListBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,8">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#98A2B3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReachable}" Value="True">
                                                        <Setter Property="Fill" Value="#12B76A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Conversations de l'opérateur choisi, façon liste de messages -->
            <Border Grid.Column="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" Margin="12,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12">
                        <TextBlock Text="{Binding SelectedOperator.Name}" FontSize="15" FontWeight="SemiBold"/>
                        <Button Content="Lire les SMS reçus" Command="{Binding ReadReceivedCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding SelectedOperator.Conversations}"
                             SelectedItem="{Binding SelectedOperator.SelectedConversation}"
                             BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="#667085" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding LastDate, StringFormat=dd/MM/yyyy HH:mm}" Foreground="#98A2B3" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Fil de la conversation choisie, en bulles, avec la saisie USSD en bas -->
            <Border Grid.Column="2" Background="#F5F5F7" BorderBrush="#D0D5DD" BorderThickness="1" Margin="12,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SelectedOperator.UssdCode, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                 ToolTip="Code USSD à envoyer, ex. *766#"/>
                        <Button Grid.Column="1" Content="Envoyer USSD" Command="{Binding SendUssdCommand}" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Solde" Command="{Binding CheckBalanceCommand}" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedOperator.SelectedConversation.Title}"
                               FontSize="15" FontWeight="SemiBold" Margin="14,12,14,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedOperator.SelectedConversation.Messages}" Margin="14,0,14,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,7" Margin="0,4" MaxWidth="420">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                        <Setter Property="Background" Value="#DCF8C6"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=''}" FontSize="9"
                                                       Foreground="Gray" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
