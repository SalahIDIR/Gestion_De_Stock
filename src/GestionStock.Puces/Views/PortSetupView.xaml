<UserControl x:Class="GestionStock.Puces.Views.PortSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="480" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" Padding="24"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Ports des modems" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Choisissez le port COM de la clé de chaque opérateur. Votre choix sera gardé pour la prochaine ouverture."
                       TextWrapping="Wrap" Foreground="#667085" Margin="0,0,0,18"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mobilis" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding MobilisPort}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Djezzy" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding DjezzyPort}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ooredoo" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding OoredooPort}"/>
            </Grid>

            <Button Content="Actualiser les ports" Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="{Binding Message}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Button Content="Continuer" Command="{Binding ContinueCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Padding="18,8"/>
        </StackPanel>
    </Border>
</UserControl>
